PORT=5000
CITY=Indore
LATITUDE=22.7196
LONGITUDE=75.8577
POLL_INTERVAL_MS=300000

# Weather fallback provider identifies the application with this User-Agent.
WEATHER_USER_AGENT=UrbanFloodWatchHackathon/1.0 contact=your-team-email@example.com

# Optional SMTP email alerts (use an app password/provider SMTP credentials)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_TO=

# Optional Twilio SMS alerts. Keep credentials private.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONE=

# Automatic weather-watch alert cooldown in minutes
ALERT_COOLDOWN_MIN=30
